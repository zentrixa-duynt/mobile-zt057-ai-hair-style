<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="16dp">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Hair Style -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_block_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_hair_style"
                android:textColor="#6A7282"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/txt_hair_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Long Straight Hair"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"/>
        </LinearLayout>

        <!-- Hair Color -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_block_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_hair_color"
                android:textColor="#6A7282"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/txt_hair_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Black"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Face Shape -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_block_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_face_shape"
                android:textColor="#6A7282"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/txt_face_shape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Oval"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"/>
        </LinearLayout>

        <!-- Hairstyle Fit Rate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_block_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_hairstyle_fit_rate"
                android:textColor="#6A7282"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/txt_fit_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="85%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
