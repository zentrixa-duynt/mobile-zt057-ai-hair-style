<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:transitionName="shared_element_container"
    android:background="#030712">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="@string/text_photo_editor"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Upload Area -->
    <FrameLayout
        android:id="@+id/layout_add_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="24dp"
        app:layout_constraintDimensionRatio="3:4"
        android:background="@drawable/bg_dashed_border"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <!-- Filled State (Hidden by default) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layout_filled_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:visibility="gone">

            <!-- Single Photo View -->
            <com.github.chrisbanes.photoview.PhotoView
                android:id="@+id/img_selected_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/backgrounds/scenic" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_hair_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/layout_add_photo_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_camera" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/text_add_photo"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_remove_photo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_close2"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_brush"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"
                android:padding="8dp"
                android:src="@drawable/ic_brush"
                android:background="@drawable/bg_btn_brush" />

            <ImageView
                android:id="@+id/btn_eraser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_eraser"
                android:background="@drawable/bg_btn_brush" />
        </LinearLayout>
    </FrameLayout>

    <!-- Thumbnails RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_thumbnails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal"
        tools:listitem="@layout/item_editor_thumbnail"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/layout_add_photo" />

    <!-- Colors Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/scroll_colors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/rv_thumbnails">

        <LinearLayout
            android:id="@+id/layout_colors_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <!-- Color Picker -->
            <ImageView
                android:id="@+id/btn_color_picker"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_color_picker" />

            <!-- None -->
            <FrameLayout
                android:id="@+id/btn_color_none"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <!-- Background when selected -->
                <View
                    android:id="@+id/bg_color_none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_color_none_selected"
                    android:visibility="gone" />
                
                <!-- Unselected icon (24x24) -->
                <ImageView
                    android:id="@+id/ic_none_unselected"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_none" />
                    
                <!-- Selected icon (20x20) -->
                <ImageView
                    android:id="@+id/ic_none_selected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_none"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Custom Picked Color (Hidden by default) -->
            <FrameLayout
                android:id="@+id/color_custom"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"> 
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_color_custom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#FFFFFF" 
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_outer_custom"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_editor_color_stroke"
                    android:visibility="gone" /> 
                <View
                    android:id="@+id/stroke_inner_custom"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" /> 
            </FrameLayout>

            <!-- White -->
            <FrameLayout
                android:id="@+id/color_white"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <!-- Outer stroke for White -->
                <View
                    android:id="@+id/stroke_outer_white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_editor_color_stroke"
                    android:visibility="gone" /> <!-- Set to VISIBLE to preview selected state -->
                <!-- Inner stroke for White -->
                <View
                    android:id="@+id/stroke_inner_white"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" /> <!-- Set to VISIBLE to preview selected state -->
            </FrameLayout>

            <!-- Black -->
            <FrameLayout
                android:id="@+id/color_black"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#000000"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <!-- Default outer stroke -->
                <View
                    android:id="@+id/stroke_outer_black"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_color_black_stroke" />
                <!-- Inner stroke when selected -->
                <View
                    android:id="@+id/stroke_inner_black"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_white"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Red -->
            <FrameLayout
                android:id="@+id/color_red"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#FB2C36"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_inner_red"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Pink -->
            <FrameLayout
                android:id="@+id/color_pink"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#F6339A"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_inner_pink"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" />
            </FrameLayout>
            
            <!-- Blue -->
            <FrameLayout
                android:id="@+id/color_blue"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#2B7FFF"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_inner_blue"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" />
            </FrameLayout>
                
            <!-- Green -->
            <FrameLayout
                android:id="@+id/color_green"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#00C950"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_inner_green"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" />
            </FrameLayout>
                
            <!-- Orange -->
            <FrameLayout
                android:id="@+id/color_orange"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#FF6900"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_inner_orange"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" />
            </FrameLayout>
                
            <!-- Yellow -->
            <FrameLayout
                android:id="@+id/color_yellow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#F0B100"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_inner_yellow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" />
            </FrameLayout>
                
            <!-- Purple -->
            <FrameLayout
                android:id="@+id/color_purple"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#AD46FF"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp" />
                <View
                    android:id="@+id/stroke_inner_purple"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_stroke_black"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Continue Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_continue"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_btn_create"
        android:text="@string/text_continue"
        android:textColor="@color/color_btn_create_text"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:textAllCaps="false"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>