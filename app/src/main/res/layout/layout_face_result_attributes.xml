<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_block_dark"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="18dp">
    
    <!-- Chin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_chin"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <eightbitlab.com.blurview.BlurTarget
                android:id="@+id/blur_target_chin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txt_chin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E2939"
                    tools:text="Defined"
                    android:textColor="#F6339A"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false" />
            </eightbitlab.com.blurview.BlurTarget>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blur_view_chin"
                app:blurOverlayColor="#0D0B0B0C"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/blur_target_chin"
                app:layout_constraintBottom_toBottomOf="@id/blur_target_chin"
                app:layout_constraintStart_toStartOf="@id/blur_target_chin"
                app:layout_constraintEnd_toEndOf="@id/blur_target_chin" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Cheekbone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_cheekbone"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <eightbitlab.com.blurview.BlurTarget
                android:id="@+id/blur_target_cheekbone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txt_cheekbone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E2939"
                    tools:text="High"
                    android:textColor="#F6339A"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false" />
            </eightbitlab.com.blurview.BlurTarget>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blur_view_cheekbone"
                app:blurOverlayColor="#0D0B0B0C"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/blur_target_cheekbone"
                app:layout_constraintBottom_toBottomOf="@id/blur_target_cheekbone"
                app:layout_constraintStart_toStartOf="@id/blur_target_cheekbone"
                app:layout_constraintEnd_toEndOf="@id/blur_target_cheekbone" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    
    <!-- Temple -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_temple"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <eightbitlab.com.blurview.BlurTarget
                android:id="@+id/blur_target_temple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txt_temple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E2939"
                    tools:text="Narrow"
                    android:textColor="#F6339A"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false" />
            </eightbitlab.com.blurview.BlurTarget>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blur_view_temple"
                app:blurOverlayColor="#0D0B0B0C"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/blur_target_temple"
                app:layout_constraintBottom_toBottomOf="@id/blur_target_temple"
                app:layout_constraintStart_toStartOf="@id/blur_target_temple"
                app:layout_constraintEnd_toEndOf="@id/blur_target_temple" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Apple Cheeks -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_apple_cheeks"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <eightbitlab.com.blurview.BlurTarget
                android:id="@+id/blur_target_apple_cheeks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/txt_apple_cheeks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E2939"
                    tools:text="Subtle"
                    android:textColor="#F6339A"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false" />
            </eightbitlab.com.blurview.BlurTarget>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blur_view_apple_cheeks"
                app:blurOverlayColor="#0D0B0B0C"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="@id/blur_target_apple_cheeks"
                app:layout_constraintBottom_toBottomOf="@id/blur_target_apple_cheeks"
                app:layout_constraintStart_toStartOf="@id/blur_target_apple_cheeks"
                app:layout_constraintEnd_toEndOf="@id/blur_target_apple_cheeks" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
