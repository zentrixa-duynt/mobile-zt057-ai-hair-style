<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712"
    android:transitionName="shared_element_container">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_ai_hair_style"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content Area -->
    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Add Photo Box -->
        <FrameLayout
            android:id="@+id/box_add_photo"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="16dp"
            android:clipToOutline="true"
            android:background="@drawable/bg_dashed_border">

            <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_camera"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/text_add_photo"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Filled State (Hidden by default) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layout_filled_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:visibility="gone">

            <!-- Single Photo View -->
            <ImageView
                android:id="@+id/img_selected_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/backgrounds/scenic" />

            <ImageView
                android:id="@+id/btn_close_photo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_close" />
        </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Tabs -->
        <com.example.aihair.core.ui.widget.SlimeLineTabBar
            android:id="@+id/tab_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="11dp"
            android:layout_gravity="center_horizontal" />

        <!-- Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_styles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="7dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            tools:listitem="@layout/item_style"
            tools:itemCount="9" />

    </LinearLayout>

    <!-- Bottom Panel (Create Button) -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="#030712"
        app:layout_constraintBottom_toTopOf="@id/frNativeAd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <FrameLayout
        android:id="@+id/btn_create_ads"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_btn_create"
        android:visibility="visible"
        android:enabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:duplicateParentState="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:duplicateParentState="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/color_btn_create_text"
                    android:duplicateParentState="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/text_create"
                    android:textColor="@color/color_btn_create_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:duplicateParentState="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_today_remaining_attempts"
                    android:textColor="@color/color_btn_create_text"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true" />

                <TextView
                    android:id="@+id/txt_today_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/color_btn_create_text"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true" />

                <TextView
                    android:id="@+id/txt_total_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_slash_five"
                    android:textColor="@color/color_btn_create_text"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/img_ad_icon_create"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_ad_icon_container"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                app:tint="#030712"
                android:src="@drawable/ic_play" />
        </FrameLayout>
    </FrameLayout>
    </LinearLayout>

    <dev.zentrixa.common.admob.ZTNativeAdView
        android:id="@+id/frNativeAd"
        app:ad_config_key="native_function"
        app:ad_placement="p_native_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>