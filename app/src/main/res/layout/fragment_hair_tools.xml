<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712"
    android:paddingHorizontal="16dp"
    android:paddingTop="7dp"
    android:paddingBottom="16dp">

    <!-- Card 1 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card1"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hairtools_card1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:maxEms="4"
            android:text="@string/text_transform_your_hairstyle"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img3"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_hairtools_card1_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/img2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/img_hairtools_card1_2"
            app:layout_constraintTop_toTopOf="@id/arrow2"
            app:layout_constraintBottom_toBottomOf="@id/arrow2"
            app:layout_constraintEnd_toStartOf="@id/arrow2" />

        <ImageView
            android:id="@+id/img1"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/img_hairtools_card1_1"
            app:layout_constraintBottom_toBottomOf="@id/arrow1"
            app:layout_constraintEnd_toStartOf="@id/arrow1"/>

        <ImageView
            android:id="@+id/arrow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_card1"
            android:layout_marginEnd="-20dp"
            android:layout_marginBottom="13dp"
            app:layout_constraintBottom_toBottomOf="@id/img3"
            app:layout_constraintTop_toTopOf="@id/img3"
            app:layout_constraintEnd_toStartOf="@id/img3" />

        <ImageView
            android:id="@+id/arrow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_card2"
            android:layout_marginBottom="14dp"
            android:layout_marginEnd="-10dp"
            app:layout_constraintEnd_toStartOf="@id/img3"
            app:layout_constraintBottom_toBottomOf="@id/img3" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card 2 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card2"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hairtools_card2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:maxEms="4"
            android:text="@string/text_change_your_hair_color"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            android:textAlignment="viewEnd"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/img4"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_hairtools_card2_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/img_hairtools_card2_2"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toBottomOf="@id/arrow3"
            app:layout_constraintStart_toEndOf="@id/arrow3" />

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/img_hairtools_card2_3"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toBottomOf="@id/arrow4"
            app:layout_constraintStart_toEndOf="@id/arrow4" />

        <ImageView
            android:id="@+id/arrow3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_card3"
            android:layout_marginStart="-26dp"
            android:layout_marginBottom="40dp"
            app:layout_constraintBottom_toBottomOf="@id/img4"
            app:layout_constraintTop_toTopOf="@id/img4"
            app:layout_constraintStart_toEndOf="@id/img4" />

        <ImageView
            android:id="@+id/arrow4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_card4"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintStart_toEndOf="@id/img4"
            app:layout_constraintBottom_toBottomOf="@id/img4"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>