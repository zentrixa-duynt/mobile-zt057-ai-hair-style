<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_report"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_flag_offensive_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:includeFontPadding="false"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/ll_report_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/cb_spam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:includeFontPadding="false"
            android:text="@string/text_spam"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:button="@null"
            android:drawableEnd="@drawable/sel_report_checkbox"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cb_inappropriate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:includeFontPadding="false"
            android:text="@string/text_inappropriate_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:button="@null"
            android:drawableEnd="@drawable/sel_report_checkbox"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cb_copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:minHeight="24dp"
            android:text="@string/text_copyright"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:button="@null"
            android:drawableEnd="@drawable/sel_report_checkbox"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cb_offensive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:includeFontPadding="false"
            android:text="@string/text_offensive"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:button="@null"
            android:drawableEnd="@drawable/sel_report_checkbox"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cb_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:includeFontPadding="false"
            android:text="@string/text_other"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:button="@null"
            android:drawableEnd="@drawable/sel_report_checkbox"
            android:layout_marginBottom="24dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_report_cancel"
            android:text="@string/text_cancel"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btn_report"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_report_submit"
            android:text="@string/text_report"
            android:textColor="#030712"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
